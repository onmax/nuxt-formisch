{
  "name": "nuxt-formisch",
  "type": "module",
  "version": "0.0.8",
  "packageManager": "pnpm@12.15.0",
  "description": "Formisch integration for Nuxt: schema-based, headless forms with Valibot and an optional Nuxt UI AutoForm",
  "author": "onmax",
  "license": "MIT",
  "homepage": "https://nuxt-formisch.onmax.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-formisch.git"
  },
  "bugs": {
    "url": "https://github.com/onmax/nuxt-formisch/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "formisch",
    "forms",
    "valibot",
    "standard-schema",
    "nuxt-ui",
    "vue"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "pnpm build",
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p playground",
    "test": "vitest run",
    "check:doctor": "vite-doctor . --max-warnings 0 --format text",
    "validate": "pnpm build && publint --strict"
  },
  "peerDependencies": {
    "@nuxt/ui": ">=4.0.0",
    "nuxt": ">=4.0.0",
    "valibot": "^1.4.1"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    }
  },
  "dependencies": {
    "@formisch/vue": "catalog:prod",
    "@nuxt/kit": "catalog:prod",
    "@standard-schema/spec": "catalog:prod",
    "scule": "catalog:prod"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:lint",
    "@nuxt/module-builder": "catalog:build",
    "@nuxt/test-utils": "catalog:test",
    "@nuxt/ui": "catalog:nuxt",
    "@types/node": "catalog:build",
    "eslint": "catalog:lint",
    "h3": "catalog:nuxt",
    "nuxt": "catalog:nuxt",
    "playwright-core": "catalog:test",
    "publint": "catalog:build",
    "tailwindcss": "catalog:nuxt",
    "typescript": "catalog:build",
    "valibot": "catalog:nuxt",
    "vite-doctor": "catalog:lint",
    "vitest": "catalog:test",
    "vue": "catalog:nuxt",
    "vue-tsc": "catalog:build"
  }
}
